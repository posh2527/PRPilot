APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:8080
DATABASE_URL=sqlite:///./prpilot.db
SESSION_SECRET=replace_with_a_long_random_secret

